# Unity .gitattributes
# Binary assets are marked binary so git never attempts a text merge on them.
# Only binary rules are applied — no line-ending normalisation on Unity files
# to avoid any risk of corruption on assets that embed binary data.

# -----------------------------------------------------------------------
# Unity YAML — no special merge driver; resolve conflicts manually.
# eol rules deliberately omitted to avoid normalisation of binary-embedded content.
# -----------------------------------------------------------------------
*.unity        -text
*.prefab       -text
*.asset        -text
*.meta         -text
*.anim         -text
*.controller   -text
*.overrideController -text
*.playable     -text
*.signal       -text

# -----------------------------------------------------------------------
# Binary — never attempt a text merge; always take one side whole
# -----------------------------------------------------------------------

# Fonts
*.ttf          binary
*.otf          binary
*.fnt          binary
*.fontsettings binary

# TMP font SDF assets (YAML wrapper around binary atlas texture data)
"Assets/TextMesh Pro/Resources/Fonts & Materials/*.asset" binary

# Textures & sprites
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.bmp          binary
*.tga          binary
*.tif          binary
*.tiff         binary
*.psd          binary
*.exr          binary
*.hdr          binary
*.pict         binary
*.dds          binary

# Audio
*.mp3          binary
*.wav          binary
*.ogg          binary
*.aiff         binary
*.aif          binary
*.flac         binary

# Video
*.mp4          binary
*.mov          binary
*.avi          binary
*.webm         binary

# 3D models
*.fbx          binary
*.FBX          binary
*.obj          binary
*.blend        binary
*.mb           binary
*.ma           binary
*.max          binary
*.dae          binary
*.3ds          binary

# Compiled / build artifacts
*.dll          binary
*.pdb          binary
*.exe          binary
*.so           binary
*.dylib        binary

# Compressed archives
*.zip          binary
*.7z           binary
*.gz           binary
*.tar          binary

# Unity-specific binary caches
*.cubemap      binary
*.unitypackage binary
*.spriteatlas  binary