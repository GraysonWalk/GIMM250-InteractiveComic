# Unity .gitattributes
# Ensures consistent line endings and correct merge behaviour across platforms.
# Binary assets are marked binary so git never attempts a text merge on them —
# merge conflicts on font files, textures, audio etc. are eliminated entirely.
# Unity YAML files (scenes, prefabs, assets) are routed through UnityYAMLMerge
# when it is configured on each developer's machine (see README — Git Setup).

# -----------------------------------------------------------------------
# Default: normalise line endings to LF on commit for all text files
# -----------------------------------------------------------------------
* text=auto

# -----------------------------------------------------------------------
# Unity YAML — normalise line endings; standard text merge.
# Conflicts in scene/prefab files must be resolved manually.
# -----------------------------------------------------------------------
*.unity        eol=lf
*.prefab       eol=lf
*.asset        eol=lf
*.meta         eol=lf
*.anim         eol=lf
*.controller   eol=lf
*.overrideController eol=lf
*.physicsMaterial    eol=lf
*.physicsMaterial2D  eol=lf
*.playable     eol=lf
*.signal       eol=lf

# -----------------------------------------------------------------------
# Binary — never attempt a text merge; always take one side whole
# -----------------------------------------------------------------------

# Fonts — the most common source of merge pain in this project
*.ttf          binary
*.otf          binary
*.fnt          binary

# TMP font assets and atlases
*.fontsettings binary

# Textures & sprites
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.bmp          binary
*.tga          binary
*.tif          binary
*.tiff         binary
*.psd          binary
*.exr          binary
*.hdr          binary
*.pict         binary
*.dds          binary

# Audio
*.mp3          binary
*.wav          binary
*.ogg          binary
*.aiff         binary
*.aif          binary
*.flac         binary
*.mod          binary
*.it           binary
*.s3m          binary

# Video
*.mp4          binary
*.mov          binary
*.avi          binary
*.webm         binary

# 3D models
*.fbx          binary
*.FBX          binary
*.obj          binary
*.blend        binary
*.mb           binary
*.ma           binary
*.max          binary
*.dae          binary
*.3ds          binary

# Compiled / build artifacts
*.dll          binary
*.pdb          binary
*.mdb          binary
*.exe          binary
*.so           binary
*.dylib        binary
*.a            binary
*.lib          binary

# Compressed archives
*.zip          binary
*.7z           binary
*.gz           binary
*.tar          binary
*.rar          binary

# Shader binaries / caches
*.cginc        text eol=lf
*.hlsl         text eol=lf
*.shader       text eol=lf
*.compute      text eol=lf
*.shadervariants binary
*.shadergraph  text eol=lf
*.shadersubgraph text eol=lf

# Unity-specific binary caches
*.cubemap      binary
*.unitypackage binary
*.spriteatlas  binary

# TMP font SDF assets contain binary atlas texture data — must be binary
# eol=lf on these corrupts the embedded texture, losing the font mesh
"Assets/TextMesh Pro/Resources/Fonts & Materials/*.asset" binary

# C# source — always text, LF
*.cs           text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.txt          text eol=lf
*.md           text eol=lf
*.asmdef       text eol=lf
*.asmref       text eol=lf
*.inputactions text eol=lf
